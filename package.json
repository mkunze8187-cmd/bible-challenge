{
  "name": "bible-challenge",
  "version": "0.1.8",
  "private": true,
  "workspaces": [
    "admin"
  ],
  "description": "Windows desktop app for scripture recall, Bible knowledge, and learning challenge modes.",
  "author": "Michael Kunze",
  "main": "electron/main.js",
  "scripts": {
    "typecheck": "tsc -p .",
    "typecheck:admin": "npm run typecheck --workspace bible-challenge-admin",
    "test": "vitest",
    "test:run": "vitest run",
    "test:admin": "npm run test:run --workspace bible-challenge-admin",
    "build": "npm run check:data && npm run typecheck && vite build",
    "build:admin": "npm run build --workspace bible-challenge-admin",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder --win nsis",
    "check:data": "node scripts/validate-data.mjs",
    "audit:study-notes": "node scripts/audit-study-notes.mjs",
    "update:verse-study-notes": "node scripts/update-verse-study-notes.mjs",
    "update:five-guesses-study-notes": "node scripts/update-five-guesses-study-notes.mjs",
    "update:chapter-who-study-notes": "node scripts/update-chapter-finder-and-who-said-it-notes.mjs",
    "update:initials-study-notes": "node scripts/update-initials-study-notes.mjs",
    "update:structured-study-notes": "node scripts/update-structured-study-notes.mjs"
  },
  "build": {
    "appId": "com.personal.biblechallenge",
    "productName": "Bible Challenge",
    "executableName": "BibleChallenge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "BibleChallenge-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
