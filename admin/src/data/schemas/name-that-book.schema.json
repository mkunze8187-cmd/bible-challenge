{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/name-that-book.schema.json",
  "title": "Name That Book Session Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "game",
    "version",
    "displayName",
    "roundsPerSession",
    "sessions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "game": {
      "const": "name-that-book"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "roundsPerSession": {
      "type": "integer",
      "minimum": 1
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/session"
      }
    }
  },
  "$defs": {
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "theme",
        "rounds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "theme": {
          "type": "string",
          "minLength": 1
        },
        "rounds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/round"
          }
        }
      }
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "book",
        "testament",
        "category",
        "aliases",
        "clues",
        "difficulty",
        "teachingNote"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "book": {
          "type": "string",
          "minLength": 1
        },
        "testament": {
          "enum": [
            "Old Testament",
            "New Testament"
          ]
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "clues": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "scriptureReference": {
          "type": "string",
          "minLength": 1
        },
        "teachingNote": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
