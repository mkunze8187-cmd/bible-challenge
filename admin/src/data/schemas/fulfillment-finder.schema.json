{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/fulfillment-finder.schema.json",
  "title": "Fulfillment Finder Challenge Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "game",
    "version",
    "displayName",
    "roundsPerSession",
    "sessions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "game": {
      "const": "fulfillment-finder"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "roundsPerSession": {
      "type": "integer",
      "minimum": 1
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/session"
      }
    }
  },
  "$defs": {
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "theme",
        "rounds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "theme": {
          "type": "string",
          "minLength": 1
        },
        "rounds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/round"
          }
        }
      }
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "theme",
        "fulfillmentReference",
        "fulfillmentSummary",
        "fulfillmentText",
        "prompt",
        "correctProphecyReference",
        "correctProphecySummary",
        "choices",
        "difficulty",
        "teachingNote"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "theme": {
          "type": "string",
          "minLength": 1
        },
        "fulfillmentReference": {
          "type": "string",
          "minLength": 1
        },
        "fulfillmentSummary": {
          "type": "string",
          "minLength": 1
        },
        "fulfillmentText": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "correctProphecyReference": {
          "type": "string",
          "minLength": 1
        },
        "correctProphecySummary": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reference",
              "summary"
            ],
            "properties": {
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "teachingNote": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
