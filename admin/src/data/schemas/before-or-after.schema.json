{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/before-or-after.schema.json",
  "title": "Before Or After Session Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "game",
    "version",
    "displayName",
    "roundsPerSession",
    "sessions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "game": {
      "const": "before-or-after"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "roundsPerSession": {
      "type": "integer",
      "minimum": 1
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/session"
      }
    }
  },
  "$defs": {
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "theme",
        "rounds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "theme": {
          "type": "string",
          "minLength": 1
        },
        "rounds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/round"
          }
        }
      }
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "leftEvent",
        "rightEvent",
        "earlierEvent",
        "explanation",
        "theme",
        "difficulty",
        "teachingNote"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "leftEvent": {
          "type": "string",
          "minLength": 1
        },
        "rightEvent": {
          "type": "string",
          "minLength": 1
        },
        "earlierEvent": {
          "enum": [
            "left",
            "right"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "theme": {
          "type": "string",
          "minLength": 1
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "teachingNote": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
