{
  "name": "bible-challenge-admin",
  "version": "0.1.9",
  "private": true,
  "description": "Admin console for the Bible Challenge desktop app: content editing, play stats, ratings, and updates.",
  "author": "Michael Kunze",
  "main": "electron/main.js",
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest",
    "test:run": "vitest run",
    "build": "npm run typecheck && vite build",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder --win nsis",
    "sync-schemas": "node scripts/sync-schemas.mjs",
    "verify-schemas-fresh": "node scripts/verify-schemas-fresh.mjs"
  },
  "build": {
    "appId": "com.personal.biblechallengeadmin",
    "productName": "Bible Challenge Admin Console",
    "executableName": "BibleChallengeAdminConsole",
    "electronVersion": "44.2.0",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "BibleChallengeAdmin-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
