{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/genealogy.schema.json",
  "title": "Fill in the Genealogy Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "game", "version", "displayName", "roundsPerSession", "sessions"],
  "properties": {
    "$schema": { "type": "string" },
    "game": { "const": "genealogy" },
    "version": { "type": "integer", "minimum": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "roundsPerSession": { "type": "integer", "minimum": 1 },
    "sessions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/session" } }
  },
  "$defs": {
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "theme", "rounds"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "theme": { "type": "string", "minLength": 1 },
        "rounds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/round" } }
      }
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "startPerson", "endPerson", "fullChain", "startFlavorText", "endFlavorText", "scriptureReference", "theme", "difficulty", "teachingNote"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "startPerson": { "type": "string", "minLength": 1 },
        "endPerson": { "type": "string", "minLength": 1 },
        "fullChain": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "startFlavorText": { "type": "string", "minLength": 1 },
        "endFlavorText": { "type": "string", "minLength": 1 },
        "scriptureReference": { "type": "string", "minLength": 1 },
        "theme": { "type": "string", "minLength": 1 },
        "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
        "teachingNote": { "type": "string", "minLength": 1 }
      }
    }
  }
}
