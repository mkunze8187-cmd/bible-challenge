{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/messiah-prophecy.schema.json",
  "title": "Messiah Prophecy Challenge Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "game",
    "version",
    "displayName",
    "roundsPerSession",
    "sessions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "game": {
      "const": "messiah-prophecy"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "roundsPerSession": {
      "type": "integer",
      "minimum": 1
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/session"
      }
    }
  },
  "$defs": {
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "theme",
        "rounds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "theme": {
          "type": "string",
          "minLength": 1
        },
        "rounds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/round"
          }
        }
      }
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "theme",
        "prophecyReference",
        "prophecyTextShort",
        "prompt",
        "correctAnswer",
        "choices",
        "fulfillmentReference",
        "fulfillmentSummary",
        "difficulty",
        "teachingNote"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "theme": {
          "type": "string",
          "minLength": 1
        },
        "prophecyReference": {
          "type": "string",
          "minLength": 1
        },
        "prophecyTextShort": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "correctAnswer": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fulfillmentReference": {
          "type": "string",
          "minLength": 1
        },
        "fulfillmentSummary": {
          "type": "string",
          "minLength": 1
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "teachingNote": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
