{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/parable-match.schema.json",
  "title": "Parable Match Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "game", "version", "displayName", "roundsPerSession", "sessions"],
  "properties": {
    "$schema": { "type": "string" },
    "game": { "const": "parable-match" },
    "version": { "type": "integer", "minimum": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "roundsPerSession": { "type": "integer", "minimum": 1 },
    "sessions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/session" } }
  },
  "$defs": {
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "theme", "rounds"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "theme": { "type": "string", "minLength": 1 },
        "rounds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/round" } }
      }
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "theme", "parableReference", "parableSummary", "parableTextShort", "lessonSummary", "lessonTextShort", "answerKey", "difficulty", "teachingNote"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "theme": { "type": "string", "minLength": 1 },
        "parableReference": { "type": "string", "minLength": 1 },
        "parableSummary": { "type": "string", "minLength": 1 },
        "parableTextShort": { "type": "string", "minLength": 1 },
        "lessonSummary": { "type": "string", "minLength": 1 },
        "lessonTextShort": { "type": "string", "minLength": 1 },
        "answerKey": { "type": "string", "minLength": 1 },
        "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
        "teachingNote": { "type": "string", "minLength": 1 }
      }
    }
  }
}
