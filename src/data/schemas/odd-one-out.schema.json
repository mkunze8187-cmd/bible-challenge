{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/odd-one-out.schema.json",
  "title": "Odd One Out Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "game", "version", "displayName", "roundsPerSession", "sessions"],
  "properties": {
    "$schema": { "type": "string" },
    "game": { "const": "odd-one-out" },
    "version": { "type": "integer", "minimum": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "roundsPerSession": { "type": "integer", "minimum": 1 },
    "sessions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/session" } }
  },
  "$defs": {
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "theme", "rounds"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "theme": { "type": "string", "minLength": 1 },
        "rounds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/round" } }
      }
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "items", "oddItem", "groupTheme", "explanation", "theme", "difficulty", "teachingNote"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "minItems": 4,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "oddItem": { "type": "string", "minLength": 1 },
        "groupTheme": { "type": "string", "minLength": 1 },
        "explanation": { "type": "string", "minLength": 1 },
        "theme": { "type": "string", "minLength": 1 },
        "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
        "teachingNote": { "type": "string", "minLength": 1 }
      }
    }
  }
}
